{
	"_version": "1.89.0",
	"sap.app": {
		"id": "complaints.complaints",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"",
				"sa",
				"tr"
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:basic",
			"version": "1.33.0",
			"toolsId": "8deaae32-6217-467f-9f87-bcc5b630833b"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v2/complaints/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "2.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"Complaints-display": {
					"semanticObject": "Complaints",
					"action": "display",
					"title": "{{Complaints-display.flpTitle}}",
					"subTitle": "{{Complaints-display.flpSubtitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.153.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "complaints.complaints.i18n.i18n",
					"supportedLocales": [
						""
					],
					"fallbackLocale": ""
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"controlAggregation": "pages",
				"controlId": "app",
				"transition": "slide",
				"type": "View",
				"viewType": "XML",
				"path": "complaints.complaints.view",
				"async": true,
				"viewPath": "complaints.complaints.view"
			},
			"routes": [
				{
					"name": "Routecomplaints",
					"pattern": ":?query:",
					"target": [
						"Targetcomplaints"
					]
				},
				{
					"name": "RouteCreateComplaint",
					"pattern": "create-complaint/{complaintNumber}",
					"target": [
						"TargetCreateComplaint"
					]
				},
				{
					"name": "RouteCreateCustomer",
					"pattern": "create-customer/{customerNumber}",
					"target": [
						"TargetCreateCustomer"
					]
				}
			],
			"targets": {
				"Targetcomplaints": {
					"id": "complaints",
					"name": "complaints"
				},
				"TargetCreateComplaint": {
					"id": "CreateComplaint",
					"name": "CreateComplaint"
				},
				"TargetCreateCustomer": {
					"id": "CreateCustomer",
					"name": "CreateCustomer"
				}
			}
		},
		"rootView": {
			"viewName": "complaints.complaints.view.App",
			"type": "XML",
			"id": "App",
			"async": true
		},
		"flexBundle": false
	},
	"sap.cloud": {
		"public": false,
		"service": "customers.app"
	}
}